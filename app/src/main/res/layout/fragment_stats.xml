<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/black_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trainingshistorie &amp; Stats"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp"/>

            <include layout="@layout/layout_stats_overview" />

            <include layout="@layout/layout_stats_chart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_exercise_progress"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Übungsfortschritt anzeigen"
                android:backgroundTint="@color/black_surface"
                android:textColor="@color/text_primary"
                app:cornerRadius="8dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historie"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Noch keine Trainings abgeschlossen."
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone"
                android:textAlignment="center"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>